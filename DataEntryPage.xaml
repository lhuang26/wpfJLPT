<Page x:Class="WpfJLPT.DataEntryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Data Entry">
    <Grid Margin="32">
        <StackPanel HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Data Entry"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button x:Name="SubmitButton"
                        Grid.Column="1"
                        Content="Submit"
                        MinWidth="100"
                        Padding="16,8"
                        Click="SubmitButton_Click" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Category"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16" />
                <WrapPanel x:Name="CategoryCheckBoxPanel"
                           Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,0,16" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Entry"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBox x:Name="EntryTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         MinHeight="34"
                         MaxLength="128"
                         HorizontalAlignment="Stretch"
                         Padding="8,5"
                         Margin="0,0,0,16" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Meaning"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBox x:Name="MeaningTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         MinHeight="34"
                         MaxLength="512"
                         Padding="8,5"
                         Margin="0,0,0,16" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="ひらがな"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBox x:Name="HiraganaTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         MinHeight="34"
                         MaxLength="32"
                         Padding="8,5"
                         Margin="0,0,0,16" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="カタカナ"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBox x:Name="KatakanaTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         MinHeight="34"
                         MaxLength="32"
                         Padding="8,5"
                         Margin="0,0,0,16" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Positive"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBox x:Name="PositiveTextBox"
                         Grid.Row="5"
                         Grid.Column="1"
                         MinHeight="34"
                         MaxLength="32"
                         Padding="8,5"
                         Margin="0,0,0,16" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Negative"
                           VerticalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBox x:Name="NegativeTextBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         MinHeight="34"
                         MaxLength="32"
                         Padding="8,5"
                         Margin="0,0,0,16" />

                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Past"
                           VerticalAlignment="Center" />
                <TextBox x:Name="PastTextBox"
                         Grid.Row="7"
                         Grid.Column="1"
                         MinHeight="34"
                         MaxLength="32"
                         Padding="8,5"
                         Margin="0,0,0,16" />

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Past Neg"
                           VerticalAlignment="Center" />
                <TextBox x:Name="PastNegTextBox"
                         Grid.Row="8"
                         Grid.Column="1"
                         MinHeight="34"
                         MaxLength="32"
                         Padding="8,5" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
