<Page x:Class="WpfJLPT.ReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Review">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ReviewItemsComboBox"
                      Grid.Column="0"
                      Width="90"
                      MinHeight="36"
                      VerticalContentAlignment="Center"
                      ToolTip="Select a review item" />
            <TextBlock Grid.Column="1"
                       Text="Review item"
                       VerticalAlignment="Center"
                       Margin="12,0" />
            <Button Content="Refresh"
                    Grid.Column="3"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Padding="12,8" />
            <Button Content="Pass"
                    Grid.Column="2"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Padding="12,8" />
            <Button Content="View"
                    Grid.Column="4"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Padding="12,8" />
        </Grid>

        <TextBox x:Name="ReviewTextDisplay"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 Padding="12" />
    </Grid>
</Page>
